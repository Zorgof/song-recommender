# =============================================================================
# Song Recommender — environment configuration
#
# Copy this file to `.env` and fill in the secrets: `cp .env.example .env`
# `.env` is git-ignored and must never be committed.
# Comments are on their own lines on purpose (safe for both Docker Compose and python-dotenv).
# =============================================================================

# --- Application -------------------------------------------------------------
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Directory for SQLite files (app.db, checkpoints.db). Mounted as a volume in Docker.
DATA_DIR=./data
# Do not recommend songs that appeared in the visitor's last N recommendations.
HISTORY_EXCLUDE_LAST_N=50
# Daily limits per visitor (browser), reset at midnight UTC; 0 = no limit. They protect a
# shared API budget when the app is public. Answering a clarifying question does not count.
DAILY_RECOMMENDATION_LIMIT=10
# Higher than the recommendation limit, so a visitor can record again before submitting.
DAILY_TRANSCRIPTION_LIMIT=20
# The same limits summed over all visitors, per UTC day; 0 = no limit. A ceiling for the day
# even when visitors come back with new browsers or private windows. Size them to your budget:
# cost of one recommendation (OpenAI Usage page) x limit x 30 days < the monthly hard limit.
DAILY_TOTAL_RECOMMENDATION_LIMIT=100
DAILY_TOTAL_TRANSCRIPTION_LIMIT=200
# Host port the app is exposed on by Docker Compose (http://localhost:<APP_PORT>). It is bound to
# 127.0.0.1 only; the public address comes from the Cloudflare Tunnel (docs/deployment.md).
APP_PORT=8080
# Public deployment with a named Cloudflare Tunnel only (docker-compose.public.yml).
# TUNNEL_TOKEN=
# Development only (APP_ENV=development): origins allowed to call the API directly, as a JSON list.
# Not needed when using the Vite dev server proxy. Default: ["http://localhost:5173"]
# CORS_ORIGINS=["http://localhost:5173"]

# --- LLM provider keys ---------------------------------------------------------
# Only the providers referenced by LLM_* tiers below need a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Model tiers -----------------------------------------------------------------
# Format: provider:model, where provider is openai | anthropic | google_genai.
# Both tiers are required; the app does not start without them (and the matching API key).
# light: routing classifier and simple requests. heavy: complex requests and escalations.
# Tiers may use different providers, for example (see docs/configuration.md):
#   LLM_LIGHT=anthropic:claude-haiku-5-5            (needs ANTHROPIC_API_KEY)
#   LLM_HEAVY=anthropic:claude-sonnet-5-5
#   LLM_LIGHT=google_genai:gemini-3.5-flash-lite    (needs GOOGLE_API_KEY)
#   LLM_HEAVY=google_genai:gemini-3.8-flash
LLM_LIGHT=openai:gpt-6-luna
LLM_HEAVY=openai:gpt-6.1-sol
# Optional fallback model per tier, used when the primary model's provider fails.
LLM_LIGHT_FALLBACK=
LLM_HEAVY_FALLBACK=
# on | off — enable provider-native reasoning (and reasoning summaries) on the heavy tier.
LLM_HEAVY_REASONING=off
# Timeout of one request to the provider, and how many times the provider SDK retries it.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Speech-to-text --------------------------------------------------------------
# openai | none  (none hides the microphone button in the UI)
STT_PROVIDER=openai
# OpenAI transcription model id. gpt-transcribe is OpenAI's recommended model for recorded
# speech and reports the detected language; gpt-4o-mini-transcribe and whisper-1 also work.
# Uses OPENAI_API_KEY, LLM_TIMEOUT_SECONDS and LLM_MAX_RETRIES.
STT_MODEL=gpt-transcribe

# --- Spotify (track verification, links, embedded player) ------------------------
# Create an app at https://developer.spotify.com/dashboard (owner needs Spotify Premium).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ISO 3166-1 alpha-2 market used for search results.
SPOTIFY_MARKET=PL

# --- YouTube (video links) -------------------------------------------------------
# Google Cloud API key with "YouTube Data API v3" enabled. Free quota: ~100 searches/day.
YOUTUBE_API_KEY=
# Timeout in seconds of one request to Spotify or YouTube.
CATALOG_TIMEOUT_SECONDS=10

# --- LangSmith (tracing, feedback, evals) ----------------------------------------
# true | false — the app works with tracing switched off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Workspace id (a UUID). Required for organization-scoped service keys (lsv2_sk_…), which get
# HTTP 403 without it; optional for personal access tokens (lsv2_pt_…).
# Find it in LangSmith → Settings → Workspaces.
LANGSMITH_WORKSPACE_ID=
# For a public deployment use a separate project (e.g. song-recommender-public), so testers'
# runs are not mixed with your own and with evals.
LANGSMITH_PROJECT=song-recommender
# US region endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
